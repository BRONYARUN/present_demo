@keyframes qIn{from{opacity:0;transform:translateY(12px);filter:blur(4px)}to{opacity:1;transform:none;filter:blur(0)}}
.term{position:relative}
.term::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;pointer-events:none;
