/* ─── скрытый режим ─── */
(function(){
  var box=document.createElement("div");
  box.className="egg";box.setAttribute("aria-hidden","true");
  document.body.appendChild(box);
  var hideT=null;
  function fire(){
    if(document.body.classList.contains("boost"))return;
    var e=(T&&T.ui&&T.ui.egg)||["HIDDEN MODE","Easter egg",""];
    document.body.classList.add("boost");
    box.innerHTML='<button class="ex" type="button" aria-label="close">✕</button>'+
      '<div class="et">'+e[0]+'</div><div class="eh">'+e[1]+'</div><div class="ed">'+e[2]+'</div>';
    box.querySelector(".ex").onclick=off;
    requestAnimationFrame(function(){box.classList.add("on")});
    clearTimeout(hideT);hideT=setTimeout(off,16000);
  }
  function off(){
    clearTimeout(hideT);box.classList.remove("on");
    setTimeout(function(){document.body.classList.remove("boost")},600);
  }
  var seq=["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"],pos=0;
  document.addEventListener("keydown",function(ev){
    var k=ev.key.length===1?ev.key.toLowerCase():ev.key;
    if(k===seq[pos]){pos++;if(pos===seq.length){pos=0;fire()}}
    else pos=(k===seq[0]?1:0);
  });
  var taps=0,tapT=null;
  var logo=document.querySelector(".brand img");
  if(logo){
    logo.style.cursor="pointer";
    logo.addEventListener("click",function(){
      taps++;clearTimeout(tapT);tapT=setTimeout(function(){taps=0},900);
      if(taps>=5){taps=0;fire()}
    });
  }
})();

/* ─── объёмная пыль и параллакс ─── */
(function(){
  var host=document.getElementById("dust");
  if(host){
    var N=window.innerWidth<900?0:26;
    for(var i=0;i<N;i++){
      var p=document.createElement("i");p.className="pt";
      var z=Math.random();                       // 0 — далеко, 1 — близко
      var size=1+z*3.2;
      p.style.width=p.style.height=size.toFixed(1)+"px";
      p.style.left=(Math.random()*100).toFixed(2)+"%";
      p.style.top=(Math.random()*100).toFixed(2)+"%";
      p.style.filter="blur("+((1-z)*1.6).toFixed(1)+"px)";
      p.style.setProperty("--o",(0.18+z*0.5).toFixed(2));
      p.style.setProperty("--dx",((Math.random()-.5)*70).toFixed(0)+"px");
      p.style.animation="floatUp "+(9+Math.random()*13).toFixed(1)+"s linear infinite";
      p.style.animationDelay="-"+(Math.random()*18).toFixed(1)+"s";
      host.appendChild(p);
    }
  }
  var layers=[].slice.call(document.querySelectorAll(".par"));
  if(!layers.length)return;
  var tx=0,ty=0,cx=0,cy=0,raf=null;
  function loop(){
    cx+=(tx-cx)*.06; cy+=(ty-cy)*.06;
    layers.forEach(function(l){
      var d=parseFloat(l.getAttribute("data-depth"))||1;
      l.style.transform="translate3d("+(cx*d).toFixed(2)+"px,"+(cy*d).toFixed(2)+"px,0)";
    });
    raf=(Math.abs(tx-cx)>.1||Math.abs(ty-cy)>.1)?requestAnimationFrame(loop):null;
  }
  function kick(){if(!raf)raf=requestAnimationFrame(loop)}
  var rm=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if(!rm){
    window.addEventListener("mousemove",function(e){
      tx=(e.clientX/window.innerWidth-.5)*-34;
      ty=(e.clientY/window.innerHeight-.5)*-22;kick()},{passive:true});
    window.addEventListener("deviceorientation",function(e){
      if(e.gamma==null)return;
      tx=Math.max(-1,Math.min(1,e.gamma/28))*-26;
      ty=Math.max(-1,Math.min(1,(e.beta-45)/32))*-16;kick()},{passive:true});
  }
})();
