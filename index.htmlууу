/* ═══════════════ визуальная отделка ═══════════════ */
:root{--r:7px; --muted2:#96A0C2}

/* ─── типографика: плотнее, читаемее ─── */
h1{letter-spacing:-.02em;line-height:1.02}
h2{letter-spacing:-.012em}
.lede{color:var(--muted2);max-width:60ch;line-height:1.62}
.row .txt{color:var(--muted2)}
.row .txt b{color:var(--paper);font-weight:600}
.card p{color:var(--muted2);line-height:1.55}
.hb .hd{color:var(--muted2)}
.vs li{color:var(--muted2)}
.eyebrow{opacity:.92}

/* акцентная строка заголовка — градиентом, а не плоским цветом */
h1 .hl,h2 .hl{background:linear-gradient(100deg,#7FEBFF 0%,#00F0FF 34%,#2D6FF0 82%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:#00F0FF}

/* ─── мягкие углы: стекло перестаёт быть резаным ─── */
.card,.hb,.lang,.term,.prize,.lead,.fs,.tl>div,.quote,.stream,.bub,.ri,.pk,.opt,.msg,.tv,.fb,.cta,.tgbtn,.nav button,.langbtn,.chip,.qb,.tin{border-radius:var(--r)}
.term{border-radius:calc(var(--r) + 3px);overflow:hidden}
.card::before,.hb::before{border-top-left-radius:var(--r)}
.vs{border-radius:calc(var(--r) + 2px);overflow:hidden}
.tl{border-radius:calc(var(--r) + 2px);overflow:hidden}
.metric b{letter-spacing:-.02em}

/* ─── карточки: волосяная линия сверху, загорается при наведении ─── */
.card,.hb{background-image:linear-gradient(90deg,rgba(0,240,255,0),rgba(0,240,255,.5),rgba(0,240,255,0)),
  linear-gradient(160deg,rgba(255,255,255,.075),rgba(255,255,255,.018) 46%,rgba(255,255,255,.03));
  background-size:100% 1px,100% 100%;background-position:0 0,0 0;background-repeat:no-repeat;
  transition:background-size .35s,transform .28s cubic-bezier(.2,.7,.2,1),box-shadow .28s,border-color .2s}
.card:hover,.hb:hover{background-size:100% 2px,100% 100%}

/* ─── карточки веток: стрелка, уезжающая вправо ─── */
.hb .hm{display:flex;align-items:center;justify-content:space-between;gap:10px}
.hb .hm::after{content:"→";font-family:var(--mono);font-size:13px;color:var(--cyan);opacity:.45;
  transform:translateX(0);transition:transform .28s cubic-bezier(.2,.7,.2,1),opacity .2s}
.hb:hover .hm::after{opacity:1;transform:translateX(5px)}
.hb.wide .hm::after{color:var(--mag)}

/* ─── чипы: плотнее, с ведущей точкой ─── */
.chip{display:inline-flex;align-items:center;gap:8px;padding:7px 13px 7px 11px;font-size:10.5px;
  letter-spacing:.1em;text-transform:uppercase;color:var(--muted2)}
.chip::before{content:"";width:4px;height:4px;border-radius:50%;background:var(--cyan);
  box-shadow:0 0 8px rgba(0,240,255,.8);flex:0 0 auto}
.chip b{letter-spacing:.06em}

/* ─── строки: подсветка при наведении ─── */
.row{transition:background .2s,padding-left .25s;border-radius:4px}
.row:hover{background:rgba(0,240,255,.045);padding-left:8px}
.row .tag{color:var(--cyan);opacity:.85;font-variant-numeric:tabular-nums}

/* ─── шапка терминала ─── */
.tbar{padding:12px 16px;box-shadow:inset 0 1px 0 rgba(255,255,255,.09)}
.kd{box-shadow:0 0 9px currentColor}
.kd.g{animation:kdPulse 2.4s ease-in-out infinite}
@keyframes kdPulse{0%,100%{opacity:.55}50%{opacity:1}}
.tbar .st{font-variant-numeric:tabular-nums;letter-spacing:.14em}

/* ─── таймлайн внедрения ─── */
.tl>div{transition:background .25s}
.tl>div:hover{background:rgba(0,240,255,.05)}
.tl .d{letter-spacing:.14em;opacity:.9}

/* ─── шаги сценария ─── */
.fs{transition:transform .22s cubic-bezier(.2,.7,.2,1),border-color .2s,background .25s}
.fs:hover{transform:translateX(4px);border-color:rgba(0,240,255,.34)}
.fs .n{font-variant-numeric:tabular-nums;opacity:.9}

/* ─── фокус с клавиатуры ─── */
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;border-radius:var(--r)}

/* ─── полоса прокрутки ─── */
.stage::-webkit-scrollbar{width:10px}
.stage::-webkit-scrollbar-track{background:transparent}
.stage::-webkit-scrollbar-thumb{background:rgba(0,240,255,.16);border-radius:20px;border:3px solid transparent;background-clip:content-box}
.stage::-webkit-scrollbar-thumb:hover{background:rgba(0,240,255,.34);background-clip:content-box}

/* ─── верхняя панель: разделители вместо каши ─── */
.topbar{gap:14px}
.act{padding-left:14px;border-left:1px solid rgba(0,240,255,.2)}
.tools{gap:12px;padding-left:14px}
.langbtn{padding:6px 10px;transition:.18s}
.counter{font-variant-numeric:tabular-nums;opacity:.9}

/* ─── титул: воздух вокруг логотипа ─── */
.hero-logo{margin-bottom:20px}
.byline{margin:0 0 26px;padding-bottom:18px;border-bottom:1px solid rgba(0,240,255,.13);max-width:520px}

@media (max-width:820px){
  .row:hover{padding-left:0;background:none}
  .fs:hover{transform:none}
  .act{padding-left:9px}
  .tools{padding-left:9px;gap:9px}
  .byline{max-width:none;margin-bottom:20px;padding-bottom:14px}
  .chip{font-size:9.5px;padding:6px 11px 6px 9px}
}

/* ═══════════ заголовок титула: газоразрядная лампа ═══════════ */
.slide h1{position:relative;isolation:isolate;color:var(--paper);will-change:opacity,transform;
  animation:hIn .8s cubic-bezier(.16,.84,.28,1) backwards,
            tubeStrike 1.35s steps(1) .05s both}

/* поджиг трубки: рваная очередь сбоев, затем ровные буквы без свечения */
@keyframes tubeStrike{
  0%  {opacity:.04;transform:translateX(0);text-shadow:none;clip-path:none;color:var(--paper)}
  2%  {opacity:1;transform:translateX(-4px) skewX(-.6deg);clip-path:inset(6% 0 64% 0);
       text-shadow:-4px 0 rgba(255,46,136,.9),4px 0 rgba(0,240,255,.9),0 0 14px rgba(159,239,255,.7)}
  4%  {opacity:.05;transform:translateX(0);text-shadow:none;clip-path:none}
  6%  {opacity:.95;transform:translateX(5px);clip-path:inset(52% 0 10% 0);
       text-shadow:5px 0 rgba(255,46,136,.85),-5px 0 rgba(0,240,255,.85),0 0 12px rgba(159,239,255,.6)}
  8%  {opacity:.06;transform:translateX(0);text-shadow:none;clip-path:none}
  10% {opacity:1;transform:translateX(-3px);clip-path:inset(26% 0 38% 0);
       text-shadow:-3px 0 rgba(255,46,136,.8),3px 0 rgba(0,240,255,.9),0 0 16px rgba(159,239,255,.7)}
  12% {opacity:.04;transform:translateX(0);text-shadow:none;clip-path:none}
  14% {opacity:.9;transform:translateX(3px);clip-path:inset(0 0 72% 0);
       text-shadow:3px 0 rgba(255,46,136,.75),-3px 0 rgba(0,240,255,.8)}
  16% {opacity:.05;transform:none;text-shadow:none;clip-path:none}
  19% {opacity:1;transform:translateX(-2px);
       text-shadow:-2px 0 rgba(255,46,136,.6),2px 0 rgba(0,240,255,.75),0 0 20px rgba(159,239,255,.7)}
  21% {opacity:.08;transform:none;text-shadow:none}
  25% {opacity:1;text-shadow:0 0 4px #fff,0 0 18px #9FEFFF,0 0 44px rgba(0,240,255,.7)}
  28% {opacity:.14;text-shadow:none}
  32% {opacity:1;text-shadow:0 0 4px #fff,0 0 16px #9FEFFF,0 0 38px rgba(0,240,255,.6)}
  44% {opacity:1;text-shadow:0 0 3px rgba(255,255,255,.7),0 0 12px rgba(159,239,255,.5),0 0 26px rgba(0,240,255,.35)}
  47% {opacity:.5;text-shadow:none}
  50% {opacity:1;text-shadow:0 0 2px rgba(255,255,255,.5),0 0 8px rgba(159,239,255,.3)}
  72% {opacity:1;text-shadow:0 0 1px rgba(255,255,255,.25)}
  100%{opacity:1;transform:none;clip-path:none;text-shadow:none;color:var(--paper)}
}

/* случайный сбой уже разогретой лампы — запускается из JS в непредсказуемый момент */
.slide h1.gl{animation:tubeBurst .34s steps(1)}
@keyframes tubeBurst{
  0%  {opacity:1;transform:none;text-shadow:none;clip-path:none}
  8%  {opacity:.15;transform:translateX(-3px);clip-path:inset(14% 0 58% 0);
       text-shadow:-3px 0 rgba(255,46,136,.8),3px 0 rgba(0,240,255,.85)}
  16% {opacity:1;transform:none;text-shadow:none;clip-path:none}
  26% {opacity:.35;transform:translateX(4px);clip-path:inset(46% 0 16% 0);
       text-shadow:4px 0 rgba(255,46,136,.7),-4px 0 rgba(0,240,255,.8)}
  36% {opacity:1;transform:none;text-shadow:none;clip-path:none}
  50% {opacity:.5;text-shadow:0 0 10px rgba(159,239,255,.5)}
  62% {opacity:1;text-shadow:none}
  74% {opacity:.72;transform:translateX(-2px)}
  100%{opacity:1;transform:none;text-shadow:none;clip-path:none}
}

/* световое пятно живёт только во время поджига, потом гаснет */
.slide h1::before{content:"";position:absolute;left:-6%;right:-6%;top:-14%;bottom:-14%;z-index:-1;
  background:radial-gradient(60% 60% at 40% 45%,rgba(0,240,255,.22),rgba(45,111,240,.09) 48%,transparent 76%);
  filter:blur(26px);opacity:0;animation:tubeHalo 1.35s steps(1) .05s both}
@keyframes tubeHalo{
  0%,4%,8%,12%,16%,21%,28%{opacity:0}
  2%,6%,10%,14%,19%,25%{opacity:.75}
  32%{opacity:.9}44%{opacity:.5}47%{opacity:0}50%{opacity:.3}
  72%{opacity:.12}100%{opacity:0}
}
.slide h1.gl::before{animation:haloBurst .34s steps(1)}
@keyframes haloBurst{0%,16%,36%,62%,100%{opacity:0}8%,26%{opacity:.55}50%{opacity:.3}}

@media (prefers-reduced-motion:reduce){
  .slide h1,.slide h1::before,.slide h1.gl{animation:none!important;opacity:1;transform:none;clip-path:none;text-shadow:none}
}

/* акцентная строка внутри заголовка светится своим цветом */
h1 .hl{filter:none}
@media (prefers-reduced-motion:reduce){
  .slide h1,.slide h1::before{animation:none!important;opacity:1;
    text-shadow:0 0 4px rgba(255,255,255,.8),0 0 18px rgba(159,239,255,.7),0 0 44px rgba(0,240,255,.5)}
}

