/* плавный отсчёт чисел */
function cnt(el,to,dec,suf){
  if(!el)return;
  if(window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    el.textContent=(dec?to.toFixed(dec):Math.round(to))+(suf||"");return}
  var from=0,t0=null,dur=620;
  function fr(t){
    if(!t0)t0=t;var k=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-k,3),v=from+(to-from)*e;
    el.textContent=(dec?v.toFixed(dec):Math.round(v))+(suf||"");
    if(k<1)requestAnimationFrame(fr)}
  requestAnimationFrame(fr);
}
function animateMetrics(scope){
  [].slice.call(scope.querySelectorAll(".metric b[data-v]")).forEach(function(b){
    cnt(b,parseFloat(b.getAttribute("data-v")),b.getAttribute("data-dec")==="1"?1:0,b.getAttribute("data-suf")||"")});
}


