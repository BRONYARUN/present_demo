function lampGlitch(){
  var h=stage.querySelector("h1");
  if(!h)return;
  if(window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches)return;
  function burst(){
    if(!h.parentNode)return;
    h.classList.remove("gl");void h.offsetWidth;h.classList.add("gl");
    dt(function(){h.classList.remove("gl")},360);
  }
  function plan(){
    dt(function(){
      if(!h.parentNode)return;
      burst();
      if(Math.random()<.35)dt(burst,420+Math.random()*500);
      plan();
    },5000+Math.random()*13000);
  }
  dt(plan,1600);
}

