@keyframes lockOn{0%{box-shadow:0 0 0 0 rgba(255,46,136,.55)}
                  55%{box-shadow:0 0 34px 6px rgba(255,46,136,.35)}
                  100%{box-shadow:0 0 24px rgba(255,46,136,.2)}}
