<style>
:root{
  --bg:#020108; --surface:rgba(12,6,26,.72); --surface-2:rgba(18,10,38,.85);
  --line:rgba(0,240,255,.18); --line-soft:rgba(0,240,255,.09);
  --cyan:#00F0FF; --mag:#FF2E88; --violet:#7B2FFF; --amber:#FFB020; --blue:#2D6FF0;
  --paper:#E4F0FF; --muted:#7E87AE;
  --display:"Unbounded",system-ui,sans-serif;
  --body:"IBM Plex Sans",system-ui,-apple-system,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --pad:clamp(20px,5vw,64px);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{min-height:100%}
body{background:var(--bg);color:var(--paper);font-family:var(--body);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
html.js,html.js body{height:100dvh}
html.js body{overflow:hidden}
::selection{background:var(--mag);color:#fff}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(1000px 560px at 82% -12%,rgba(255,46,136,.13),transparent 62%),
             radial-gradient(820px 560px at -10% 112%,rgba(0,240,255,.12),transparent 60%),
             radial-gradient(760px 520px at 50% 122%,rgba(45,111,240,.12),transparent 65%)}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:3;opacity:.5;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.2) 0 1px,transparent 1px 3px),
             radial-gradient(120% 95% at 50% 50%,transparent 55%,rgba(0,0,0,.55))}
.bg-grid{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.28;
  background-image:linear-gradient(rgba(0,240,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,240,255,.05) 1px,transparent 1px);
  background-size:76px 76px;
  -webkit-mask-image:radial-gradient(125% 95% at 50% 38%,#000 18%,transparent 78%);
          mask-image:radial-gradient(125% 95% at 50% 38%,#000 18%,transparent 78%)}
.nojs{display:none}
html:not(.js) .nojs{display:block;position:fixed;left:0;right:0;top:0;z-index:99;background:#FF2E88;color:#fff;padding:14px 18px;font-family:var(--mono);font-size:13px;text-align:center}

/* ---------- shell ---------- */
.deck{position:relative;z-index:1;height:100%;display:flex;flex-direction:column}
.topbar{display:flex;align-items:center;gap:16px;padding:18px var(--pad) 0;font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);flex:0 0 auto}
.brand{display:inline-flex;align-items:center;gap:9px;color:var(--paper)}
.brand img{height:19px;width:auto;filter:drop-shadow(0 0 10px rgba(45,111,240,.55))}
.brand b{color:var(--cyan);font-weight:500}
.act{color:var(--cyan);letter-spacing:.18em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.act.trk{color:var(--mag)}
.tools{margin-left:auto;display:flex;align-items:center;gap:14px}
.langbtn{background:none;border:1px solid var(--line);color:var(--muted);font-family:var(--mono);font-size:10px;letter-spacing:.14em;padding:5px 9px;cursor:pointer;text-transform:uppercase}
.langbtn:hover{border-color:var(--cyan);color:var(--cyan)}
.counter{color:var(--cyan);white-space:nowrap}
.track{height:2px;background:rgba(0,240,255,.1);margin:16px var(--pad) 0;position:relative;overflow:hidden;flex:0 0 auto}
.track i{position:absolute;inset:0 auto 0 0;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--mag));width:0;transition:width .45s cubic-bezier(.2,.7,.2,1);box-shadow:0 0 12px rgba(0,240,255,.6)}
.stage{flex:1 1 auto;overflow-y:auto;overflow-x:hidden;position:relative}
.slide{padding:clamp(22px,4vh,46px) var(--pad) 120px;max-width:1160px;animation:rise .4s cubic-bezier(.2,.7,.2,1)}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* ---------- type ---------- */
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px}
.eyebrow::before{content:"> "}
h1{font-family:var(--display);font-weight:900;font-size:clamp(27px,5vw,58px);line-height:1.05;text-transform:uppercase;text-wrap:balance;letter-spacing:-.01em}
h2{font-family:var(--display);font-weight:800;font-size:clamp(21px,3.2vw,36px);line-height:1.14;text-wrap:balance;margin-bottom:8px}
h3{font-family:var(--display);font-weight:700;font-size:16px;margin-bottom:8px}
.lede{font-size:clamp(15.5px,1.5vw,19px);color:var(--muted);max-width:64ch;margin-top:16px;line-height:1.6}
.hl{color:var(--cyan)}
.hero-logo{height:clamp(46px,7vw,76px);width:auto;display:block;margin-bottom:26px;filter:drop-shadow(0 0 26px rgba(45,111,240,.5))}
.cur{display:inline-block;color:var(--cyan);animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* ---------- blocks ---------- */
.rows{margin-top:24px;border-top:1px solid var(--line-soft)}
.row{display:flex;gap:20px;padding:14px 0;border-bottom:1px solid var(--line-soft);align-items:baseline}
.row .tag{font-family:var(--mono);font-size:11px;color:var(--cyan);flex:0 0 104px;letter-spacing:.06em}
.row .txt{flex:1;font-size:15.5px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:16px;margin-top:24px}
.card{position:relative;background:var(--surface);border:1px solid var(--line);padding:20px 18px}
.card::before{content:"";position:absolute;top:-1px;left:-1px;width:13px;height:13px;border-top:1px solid var(--cyan);border-left:1px solid var(--cyan)}
.card .k{font-family:var(--mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}
.card p{font-size:15px;color:var(--muted)}
.card p b{color:var(--paper);font-weight:600}
.vs{display:grid;grid-template-columns:1fr 1fr;margin-top:24px;border:1px solid var(--line)}
.vs>div{padding:22px 20px}
.vs>div:first-child{background:rgba(255,255,255,.02);border-right:1px solid var(--line)}
.vs>div:last-child{background:var(--surface-2)}
.vs h3{color:var(--muted);font-size:11px;font-family:var(--mono);font-weight:400;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}
.vs>div:last-child h3{color:var(--cyan)}
.vs ul{list-style:none;font-size:15px}
.vs li{padding:6px 0 6px 17px;position:relative;color:var(--muted)}
.vs li::before{content:"";position:absolute;left:0;top:14px;width:6px;height:1px;background:var(--line)}
.vs>div:last-child li{color:var(--paper)}
.vs>div:last-child li::before{background:var(--cyan)}
.flow{display:grid;gap:9px;margin-top:24px}
.fs{display:flex;gap:16px;align-items:flex-start;border:1px solid var(--line);background:var(--surface);padding:14px 16px}
.fs .n{font-family:var(--mono);font-size:11px;color:var(--cyan);flex:0 0 26px;padding-top:3px}
.fs .ft{font-size:15.5px;font-weight:600;margin-bottom:3px}
.fs .fd{font-size:14px;color:var(--muted);line-height:1.5}
.fs.acc{border-color:var(--mag);background:rgba(255,46,136,.06)}
.fs.acc .n{color:var(--mag)}
.tl{display:grid;grid-template-columns:repeat(auto-fit,minmax(146px,1fr));margin-top:24px;border:1px solid var(--line)}
.tl>div{padding:15px 14px;border-right:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.tl .d{font-family:var(--mono);font-size:11px;color:var(--cyan);margin-bottom:8px}
.tl .t{font-size:14.5px;font-weight:600;margin-bottom:4px}
.tl p{font-size:13.5px;color:var(--muted);line-height:1.5}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.chip{font-family:var(--mono);font-size:11px;padding:7px 12px;border:1px solid var(--line);color:var(--muted);background:rgba(0,240,255,.03)}
.chip b{color:var(--cyan);font-weight:500}
.legal{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:24px;padding-top:14px;border-top:1px solid var(--line-soft);line-height:1.9}
.legal b{color:var(--paper);font-weight:500}

/* ---------- language picker ---------- */
.langwrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(224px,1fr));gap:12px;margin-top:30px;max-width:960px}
.lang{position:relative;text-align:left;border:1px solid var(--line);background:var(--surface);padding:22px 20px;cursor:pointer;color:var(--paper);transition:border-color .16s,box-shadow .16s,transform .16s,background .16s}
.lang:hover{border-color:var(--cyan);background:rgba(0,240,255,.07);transform:translateY(-2px);box-shadow:0 0 30px rgba(0,240,255,.2)}
.lang .lc{font-family:var(--mono);font-size:10px;letter-spacing:.22em;color:var(--cyan);margin-bottom:10px}
.lang .ln{font-family:var(--display);font-weight:700;font-size:20px;margin-bottom:6px}
.lang .ld{font-size:14px;color:var(--muted)}

/* ---------- hub ---------- */
.hub{display:grid;grid-template-columns:repeat(auto-fit,minmax(252px,1fr));gap:12px;margin-top:24px}
.hb{position:relative;text-align:left;border:1px solid var(--line);background:var(--surface);padding:19px 17px;cursor:pointer;color:var(--paper);transition:border-color .16s,box-shadow .16s,transform .16s,background .16s}
.hb::before{content:"";position:absolute;top:-1px;left:-1px;width:12px;height:12px;border-top:1px solid var(--cyan);border-left:1px solid var(--cyan);opacity:.5}
.hb:hover{border-color:var(--cyan);background:rgba(0,240,255,.06);transform:translateY(-2px);box-shadow:0 0 28px rgba(0,240,255,.2)}
.hb .hn{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}
.hb .ht{font-family:var(--display);font-weight:700;font-size:16.5px;line-height:1.22;margin-bottom:7px}
.hb .hd{font-size:14px;color:var(--muted);line-height:1.5}
.hb .hm{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--muted);margin-top:13px;padding-top:10px;border-top:1px solid var(--line-soft)}
.hb .hm b{color:var(--cyan);font-weight:500}
.hb.wide{grid-column:1/-1;border-color:rgba(255,46,136,.35);background:rgba(255,46,136,.05)}
.hb.wide .hn,.hb.wide .hm b{color:var(--mag)}
.hb.wide:hover{border-color:var(--mag);background:rgba(255,46,136,.11);box-shadow:0 0 34px rgba(255,46,136,.3)}
.hb.on{border-color:var(--cyan);box-shadow:0 0 26px rgba(0,240,255,.22)}

/* ---------- terminal frame ---------- */
.term{margin-top:22px;border:1px solid var(--line);background:rgba(2,1,8,.9);box-shadow:0 0 60px rgba(0,240,255,.06),inset 0 0 90px rgba(0,0,0,.5)}
.tbar{display:flex;align-items:center;gap:8px;padding:11px 15px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.kd{width:8px;height:8px;border-radius:50%}
.kd.r{background:var(--mag)}.kd.y{background:var(--amber)}.kd.g{background:var(--cyan)}
.tbar .tt{margin-left:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tbar .st{margin-left:auto;color:var(--cyan);white-space:nowrap}
.tbody{padding:clamp(16px,2.6vw,26px)}
.qline{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--cyan);text-transform:uppercase;margin-bottom:14px}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:10px}
.opt{font-family:var(--body);font-size:15.5px;font-weight:500;color:var(--paper);background:rgba(0,240,255,.02);border:1px solid var(--line);padding:15px 14px;text-align:left;cursor:pointer;transition:.16s}
.opt:hover{border-color:var(--cyan);background:rgba(0,240,255,.07);transform:translateY(-1px);box-shadow:0 0 20px rgba(0,240,255,.2)}
.pick{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:20px}
.pk{font-size:14.5px;color:var(--paper);background:rgba(0,240,255,.03);border:1px solid var(--line);padding:11px 15px;cursor:pointer;transition:.16s;text-align:left}
.pk:hover{border-color:var(--cyan);background:rgba(0,240,255,.08)}
.pk.on{border-color:var(--mag);color:var(--mag);box-shadow:0 0 22px rgba(255,46,136,.2)}
.q{font-family:var(--display);font-weight:700;font-size:clamp(17px,2.2vw,25px);line-height:1.22;margin-bottom:20px;min-height:1.3em}
.ascii{font-family:var(--mono);font-size:12px;letter-spacing:2px;color:var(--cyan);margin-bottom:18px}
.ascii .e{color:rgba(0,240,255,.22)}
.log{margin-top:18px;font-family:var(--mono);font-size:11.5px;color:var(--muted);line-height:1.9}
.log .ok{color:var(--cyan)}
.note{color:var(--muted);font-size:13.5px;max-width:60ch;margin-top:16px;line-height:1.6}
.restart{margin-top:18px;background:none;border:none;color:var(--muted);font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.restart:hover{color:var(--cyan)}
.status{display:inline-block;padding:6px 13px;font-family:var(--mono);font-size:11px;letter-spacing:.2em;border:1px solid currentColor;margin-bottom:14px}
.status.hot{color:var(--mag)}.status.warm{color:var(--amber)}.status.cold{color:var(--muted)}
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:16px;margin:16px 0 4px}
.metric b{display:block;font-family:var(--display);font-weight:900;font-size:clamp(23px,3.2vw,31px);color:var(--cyan);line-height:1}
.metric span{display:block;font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:7px;line-height:1.5}
.prize{border:1px solid var(--cyan);padding:19px;margin-top:4px;background:linear-gradient(180deg,rgba(0,240,255,.1),rgba(0,240,255,.015))}
.prize .pk2{font-family:var(--mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);margin-bottom:9px}
.prize .pt{font-family:var(--display);font-weight:800;font-size:clamp(17px,2.3vw,24px);line-height:1.18}
.gate{display:inline-flex;gap:8px;font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);border:1px solid rgba(255,176,32,.45);padding:5px 11px;margin-bottom:14px}
.locked{filter:blur(5px);opacity:.5;pointer-events:none}
.fld{margin-bottom:16px;max-width:400px}
.fld label{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.tin{width:100%;background:transparent;border:none;border-bottom:1px solid var(--line);color:var(--paper);font-family:var(--mono);font-size:15px;padding:9px 2px;outline:none}
.tin:focus{border-color:var(--cyan)}
.cta{margin-top:18px;background:var(--mag);color:#06020D;border:none;cursor:pointer;font-family:var(--mono);font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;padding:15px 26px;box-shadow:0 0 26px rgba(255,46,136,.45)}
.cta:hover{box-shadow:0 0 40px rgba(255,46,136,.7)}
.forkq{font-family:var(--display);font-weight:700;font-size:clamp(16px,2vw,21px);margin:20px 0 13px;line-height:1.25}
.fbs{display:flex;gap:10px;flex-wrap:wrap}
.fb{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:13px 24px;cursor:pointer;border:1px solid var(--line);background:rgba(0,240,255,.04);color:var(--paper)}
.fb.y{border-color:var(--mag);color:var(--mag)}
.fb.y:hover{background:rgba(255,46,136,.12)}
.fb.n:hover{border-color:var(--cyan);color:var(--cyan)}
.leave{margin-top:14px;background:none;border:none;color:rgba(126,135,174,.75);font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;text-decoration:underline}
.leave:hover{color:var(--mag)}
.lead{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--cyan);padding:18px;font-family:var(--mono);font-size:13px;line-height:1.95;margin-top:18px}
.lead .l{color:var(--muted);display:inline-block;min-width:108px}
.lead .sc{color:var(--mag)}

/* ---------- routine counter ---------- */
.rt{display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:9px}
.ri{display:flex;align-items:center;gap:11px;border:1px solid var(--line);background:rgba(0,240,255,.02);padding:12px 13px;cursor:pointer;text-align:left;color:var(--paper);transition:.16s}
.ri:hover{border-color:rgba(0,240,255,.5)}
.ri .bx{width:16px;height:16px;border:1px solid var(--line);flex:0 0 auto;position:relative}
.ri.on{border-color:var(--cyan);background:rgba(0,240,255,.08)}
.ri.on .bx{border-color:var(--cyan);background:var(--cyan)}
.ri.on .bx::after{content:"✓";position:absolute;inset:0;color:#020108;font-size:12px;line-height:14px;text-align:center;font-weight:700}
.ri .nm{font-size:14.5px;flex:1;line-height:1.35}
.ri .hr{font-family:var(--mono);font-size:11px;color:var(--muted)}
.ri.on .hr{color:var(--cyan)}
.rtout{margin-top:20px;border-top:1px solid var(--line-soft);padding-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:16px}
.rtout .metric b{color:var(--mag)}

/* ---------- chat / assistant ---------- */
.cw{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}
.chat{padding:clamp(15px,2.2vw,22px);border-right:1px solid var(--line);min-height:390px;display:flex;flex-direction:column}
.bubs{flex:1;display:flex;flex-direction:column;gap:11px;margin-bottom:16px}
.bub{max-width:88%;padding:11px 14px;font-size:14.5px;line-height:1.45;border:1px solid var(--line);background:var(--surface);animation:rise .3s ease}
.bub.bot{align-self:flex-start;border-left:2px solid var(--cyan)}
.bub.me{align-self:flex-end;border-right:2px solid var(--mag);background:rgba(255,46,136,.07);border-color:rgba(255,46,136,.3)}
.bub .who{display:block;font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.bub.bot .who{color:var(--cyan)}.bub.me .who{color:var(--mag)}
.typing{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:.12em}
.quick{display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid var(--line-soft);padding-top:14px}
.qb{font-size:14px;color:var(--paper);background:rgba(255,46,136,.05);border:1px solid rgba(255,46,136,.3);padding:10px 14px;cursor:pointer}
.qb:hover{background:rgba(255,46,136,.14)}
.sysp{padding:clamp(15px,2.2vw,22px);background:rgba(0,240,255,.02)}
.sysp .sh{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin-bottom:14px}
.sl{font-family:var(--mono);font-size:11.5px;line-height:1.6;padding:8px 0;border-bottom:1px solid var(--line-soft);animation:rise .3s ease}
.sl i{font-style:normal;color:var(--cyan);margin-right:7px}
.sl.m i{color:var(--mag)}
