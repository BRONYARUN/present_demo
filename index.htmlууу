/* ─── камера: пролёт по серверной и панорама в конце ─── */
var CAM=(function(){
  var wraps=[];
  function init(){
    [].slice.call(document.querySelectorAll(".par")).forEach(function(l){
      var w=document.createElement("div");
      w.className="camwrap";
      w.setAttribute("data-k",l.className.indexOf("near-fx")>=0?"3":
                              l.className.indexOf("dust")>=0?"2":
                              l.className.indexOf("scene")>=0?"1":"0");
      l.parentNode.insertBefore(w,l);w.appendChild(l);wraps.push(w);
    });
    var warp=document.createElement("div");warp.className="warp";document.body.appendChild(warp);
  }
  /* насколько сильно каждый слой реагирует на шаг камеры: дальний почти стоит, ближний летит */
  var K=[[0.03,0.5],[0.07,1.4],[0.09,1.9],[0.14,2.8]];   // [прирост масштаба, снос по X в %]
  function go(p,last){
    wraps.forEach(function(w){
      var k=K[+w.getAttribute("data-k")];
      var sc,x;
      if(last){ sc=0.93+k[0]*0.2; x=0 }                    // панорама: отъезд и центровка
      else    { sc=1+p*k[0];      x=-p*k[1] }
      w.style.transform="translate3d("+x.toFixed(2)+"%,0,0) scale("+sc.toFixed(3)+")";
    });
    document.body.classList.toggle("pano",!!last);
  }
  return {init:init,go:go};
})();
CAM.init();
var moveT=null;
function camStep(){
  if(!CAM)return;
  var last=route.length-1;
  var id=route[idx];
  CAM.go(last>0?idx/last:0, idx===last && idx>2);
  document.body.classList.toggle("reading", idx>2 && idx<last);
  document.body.classList.add("moving");
  clearTimeout(moveT);
  moveT=setTimeout(function(){document.body.classList.remove("moving")},780);
}


